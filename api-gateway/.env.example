# =========================================
# SERVER
# =========================================
PORT=5000
ENV=development

# =========================================
# MICROSERVICES
# =========================================
AUTH_SERVICE=http://auth-service:5001
CHAT_SERVICE=http://chat-service:5002

# =========================================
# CORS
# =========================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# =========================================
# JWT / INTERNAL AUTH
# =========================================

# Shared JWT secret across services
JWT_AUTH_SECRET=

# Internal gateway-to-service secret
GATEWAY_SECRET=

# =========================================
# COOKIE CONFIG
# =========================================
COOKIE_KEYS='{
  "jwt_token":"auth_token",
  "crypto_token":"crypto_token",
  "otp_verified":"otp_verified"
}'