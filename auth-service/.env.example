# =========================================
# SERVER
# =========================================
PORT=5001

# =========================================
# MICROSERVICES
# =========================================
EMAIL_SERVICE=http://email-service:5003

# =========================================
# MESSAGE BROKER
# =========================================
RABBIT_MQ_URI=

# Enable only for local/dev testing
BYPASS_VERIFICATION=false

# =========================================
# DATABASE
# =========================================
MONGO_URI=mongodb://localhost:27017/uchat

# =========================================
# PASSWORD SECURITY
# =========================================
PASSWORD_PEPPER=

# Recommended: 10-12
PASSWORD_SALT_WORK_FACTOR=10

# =========================================
# JWT / AUTH
# =========================================

# Shared across services for auth verification
JWT_AUTH_SECRET=

# Internal gateway-to-service secret
GATEWAY_SECRET=

# =========================================
# REDIS
# =========================================
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# =========================================
# ENVIRONMENT
# =========================================
ENV=development

# =========================================
# COOKIES
# =========================================
COOKIE_KEYS='{
  "jwt_token":"auth_token",
  "crypto_token":"crypto_token",
  "otp_verified":"otp_verified"
}'

# =========================================
# REDIS KEY PREFIXES
# =========================================
REDIS_KEY_PREFIX='{
  "account_verification":"account_verification",
  "reset_password":"reset_password"
}'